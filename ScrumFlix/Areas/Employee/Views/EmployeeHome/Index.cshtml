@*
 * View:    Areas/Employee/Views/Home/Index.cshtml
 * Model:   ScrumFlix.Areas.Employee.ViewModels.EmployeeDashboardViewModel
 * Layout:  _EmployeeLayout (via _ViewStart.cshtml)
 * Purpose: Employee Portal home dashboard — landing page for RoleId 3 users.
 *
 * Sections rendered:
 *   — Greeting banner with employee name and location
 *   — "Profile incomplete" notice if HasEmployee is false
 *   — Today's shifts hero card (or a "no shifts today" state)
 *   — Upcoming shifts table (next 7 days, excluding today)
 *   — Phase 5 stub card: Time Tracking (disabled)
 *   — Phase 8 stub card: Pay Stubs (disabled)
 *
 * NO ViewBag reads — all data comes through EmployeeDashboardViewModel.
 * No raw hx-* attributes — Htmx.TagHelpers used for any HTMX attributes added in Phase 5.
 *
 * Phase:  4 — Employee Area Scaffold
 *@
@model EmployeeDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";

    var today       = DateTime.Today;
    var greeting    = DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _    => "Good evening"
    };

    // Shifts that start after today (for the Upcoming table — today's appear in the hero card).
    var futureShifts = Model.UpcomingShifts.Where(s => !s.IsToday).ToList();
}

@* ── Page content ────────────────────────────────────────────────────────── *@
<div class="sf-admin-section">

    @* ── Greeting banner ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 class="sf-admin-section-title mb-1">
                @greeting, @Model.FullName.Split(' ')[0]
                <i class="bi bi-hand-wave ms-1" aria-hidden="true"></i>
            </h1>
            <p class="text-muted mb-0" style="font-size: .95rem;">
                @if (Model.LocationName is not null)
                {
                    <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>
                    @Model.LocationName
                    <span class="mx-2" aria-hidden="true">·</span>
                }
                <span>@DateTime.Today.ToString("dddd, MMMM d")</span>
            </p>
        </div>
        @* Phase 5: replace this with a real Clock In / Clock Out button *@
        <span class="badge bg-secondary px-3 py-2"
              style="font-size:.8rem; opacity:.7;"
              title="Time tracking ships in Phase 5">
            <i class="bi bi-clock me-1" aria-hidden="true"></i>Time Tracking — Coming Soon
        </span>
    </div>

    @* ── Profile incomplete notice ──────────────────────────────────────── *@
    @if (!Model.HasEmployee)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
            <div>
                <strong>Employee profile not linked.</strong>
                Your user account does not have an associated Employee record.
                Contact an Administrator to have your profile completed.
                Schedule, pay rate, and location data will not be available until then.
            </div>
        </div>
    }

    @* ── Today's Shifts hero card ────────────────────────────────────────── *@
    <div class="card mb-4" style="border: 1px solid var(--sf-border); background: var(--sf-surface);">
        <div class="card-header d-flex align-items-center justify-content-between"
             style="background: var(--sf-surface-raised); border-bottom: 1px solid var(--sf-border);">
            <span class="fw-semibold" style="color: var(--sf-text-primary);">
                <i class="bi bi-calendar-check me-2" aria-hidden="true"></i>Today's Schedule
            </span>
            <span class="badge"
                  style="background: var(--sf-accent); color: var(--primitive-white);">
                @Model.TodayShifts.Count shift@(Model.TodayShifts.Count == 1 ? "" : "s")
            </span>
        </div>
        <div class="card-body p-0">
            @if (!Model.TodayShifts.Any())
            {
                <div class="d-flex flex-column align-items-center justify-content-center py-5 gap-2"
                     style="color: var(--sf-text-muted);">
                    <i class="bi bi-moon-stars" style="font-size: 2rem;" aria-hidden="true"></i>
                    <p class="mb-0 fw-semibold">No shifts scheduled for today</p>
                    <p class="mb-0" style="font-size: .85rem;">Enjoy your day off!</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var shift in Model.TodayShifts)
                    {
                        <div class="list-group-item d-flex align-items-center gap-3 py-3 px-4"
                             style="background: var(--sf-surface); border-color: var(--sf-border);">

                            @* Time block *@
                            <div class="text-center"
                                 style="min-width: 4.5rem; color: var(--sf-accent);">
                                <div class="fw-bold" style="font-size: 1.1rem; line-height: 1.2;">
                                    @shift.StartTime.ToString("h:mm")
                                </div>
                                <div style="font-size: .7rem; text-transform: uppercase; letter-spacing: .05em;">
                                    @shift.StartTime.ToString("tt")
                                </div>
                            </div>

                            @* Separator *@
                            <div style="width: 1px; height: 2.5rem; background: var(--sf-border);"
                                 aria-hidden="true"></div>

                            @* Shift details *@
                            <div class="flex-grow-1">
                                <div class="fw-semibold" style="color: var(--sf-text-primary); font-size: .95rem;">
                                    @shift.AssignmentArea
                                </div>
                                <div style="color: var(--sf-text-muted); font-size: .82rem;">
                                    @shift.StartTime.ToString("h:mm tt") – @shift.EndTime.ToString("h:mm tt")
                                    @if (shift.LocationName is not null)
                                    {
                                        <span class="mx-1" aria-hidden="true">·</span>
                                        @shift.LocationName
                                    }
                                </div>
                            </div>

                            @* Duration badge *@
                            <span class="badge"
                                  style="background: var(--sf-surface-raised); color: var(--sf-text-secondary);
                                         border: 1px solid var(--sf-border); font-size: .75rem;">
                                <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                                @shift.FormattedDuration
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ── Upcoming shifts (next 7 days, excluding today) ──────────────────── *@
    @if (futureShifts.Any())
    {
        <div class="card mb-4" style="border: 1px solid var(--sf-border); background: var(--sf-surface);">
            <div class="card-header"
                 style="background: var(--sf-surface-raised); border-bottom: 1px solid var(--sf-border);">
                <span class="fw-semibold" style="color: var(--sf-text-primary);">
                    <i class="bi bi-calendar3 me-2" aria-hidden="true"></i>Upcoming Shifts
                    <span class="text-muted fw-normal ms-1" style="font-size: .85rem;">next 7 days</span>
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0 sf-admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Date</th>
                                <th scope="col">Start</th>
                                <th scope="col">End</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Area</th>
                                <th scope="col">Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shift in futureShifts)
                            {
                                <tr>
                                    <td class="fw-semibold" style="color: var(--sf-text-primary);">
                                        @shift.StartTime.ToString("ddd, MMM d")
                                    </td>
                                    <td>@shift.StartTime.ToString("h:mm tt")</td>
                                    <td>@shift.EndTime.ToString("h:mm tt")</td>
                                    <td>
                                        <span class="badge"
                                              style="background: var(--sf-surface-raised);
                                                     color: var(--sf-text-secondary);
                                                     border: 1px solid var(--sf-border);">
                                            @shift.FormattedDuration
                                        </span>
                                    </td>
                                    <td>@shift.AssignmentArea</td>
                                    <td style="color: var(--sf-text-muted);">
                                        @(shift.LocationName ?? "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (!Model.TodayShifts.Any())
    {
        @* No shifts at all this week *@
        <div class="card mb-4" style="border: 1px solid var(--sf-border); background: var(--sf-surface);">
            <div class="card-body d-flex align-items-center gap-3 py-4 px-4"
                 style="color: var(--sf-text-muted);">
                <i class="bi bi-calendar-x" style="font-size: 1.4rem;" aria-hidden="true"></i>
                <span>No shifts scheduled in the next 7 days.</span>
            </div>
        </div>
    }

    @* ── Phase 5 / Phase 8 stub cards ────────────────────────────────────── *@
    <div class="row g-3 mt-1">

        @* Phase 5: Time Tracking stub *@
        <div class="col-12 col-md-6">
            <div class="card h-100"
                 style="border: 1px solid var(--sf-border); background: var(--sf-surface); opacity: .65;">
                <div class="card-body d-flex flex-column align-items-center justify-content-center
                            text-center gap-2 py-5"
                     style="color: var(--sf-text-muted);">
                    <i class="bi bi-clock-history" style="font-size: 2.5rem;" aria-hidden="true"></i>
                    <h2 class="h6 mb-0 fw-semibold" style="color: var(--sf-text-secondary);">
                        Time Tracking
                    </h2>
                    <p class="mb-0" style="font-size: .82rem;">Clock in, clock out, and view hours</p>
                    <span class="badge bg-secondary mt-1" style="font-size: .7rem;">
                        Arriving Phase 5
                    </span>
                </div>
            </div>
        </div>

        @* Phase 8: Pay Stubs stub *@
        <div class="col-12 col-md-6">
            <div class="card h-100"
                 style="border: 1px solid var(--sf-border); background: var(--sf-surface); opacity: .65;">
                <div class="card-body d-flex flex-column align-items-center justify-content-center
                            text-center gap-2 py-5"
                     style="color: var(--sf-text-muted);">
                    <i class="bi bi-receipt-cutoff" style="font-size: 2.5rem;" aria-hidden="true"></i>
                    <h2 class="h6 mb-0 fw-semibold" style="color: var(--sf-text-secondary);">
                        Pay Stubs
                    </h2>
                    <p class="mb-0" style="font-size: .82rem;">View and download your pay statements</p>
                    <span class="badge bg-secondary mt-1" style="font-size: .7rem;">
                        Arriving Phase 8
                    </span>
                </div>
            </div>
        </div>

    </div>
</div>
