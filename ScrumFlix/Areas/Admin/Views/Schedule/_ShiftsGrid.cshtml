@*
 * Partial: _ShiftsGrid.cshtml
 * Swapped by HTMX and by SignalR ShiftsUpdated event.
 *
 * FIX: Row hx-get was a hardcoded string "/Admin/Schedule/GetShift/@s.ShiftId"
 *      — converted to Url.Action() so route changes are picked up automatically.
 *
 * FIX: Delete form was a plain HTML POST with no HTMX attributes. Without HTMX
 *      on the form, the controller's PartialView response rendered as a bare HTML
 *      page. Added hx-post / hx-target / hx-swap to match every other form on
 *      this page.
 *
 * FIX: onsubmit="return confirm(...)" removed — inline event handlers are a CSP
 *      violation. Replaced with hx-confirm which HTMX handles natively without
 *      inline JS.
 *@
@model List<ScrumFlix.Areas.Admin.ViewModels.ShiftRowViewModel>

@if (!Model.Any())
{
    <p class="sf-text-muted mt-3">No shifts defined yet. Add one using the form.</p>
}
else
{
    <div class="sf-admin-table-wrap">
    <div class="table-responsive">
        <table class="table sf-admin-table" aria-label="Shifts">
            <thead>
                <tr>
                    <th scope="col">Location</th>
                    <th scope="col">Role</th>
                    <th scope="col">Start</th>
                    <th scope="col">End</th>
                    <th scope="col">Duration</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var duration   = (s.EndTime - s.StartTime).TotalHours;
                    var editUrl    = Url.Action("GetShift",    "Schedule", new { area = "Admin", id = s.ShiftId });
                    var deleteUrl  = Url.Action("DeleteShift", "Schedule", new { area = "Admin" });

                    <tr hx-get="@editUrl"
                        hx-target="#shift-form-container"
                        hx-trigger="click"
                        style="cursor:pointer;"
                        title="Click to edit">
                        <td>@s.LocationName</td>
                        <td>@s.RoleName</td>
                        <td>@s.StartTime.ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>@s.EndTime.ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>@duration.ToString("0.0")h</td>
                        <td class="text-end" onclick="event.stopPropagation()">
                            @* FIX: added hx-post/hx-target/hx-swap so the delete response
                               is swapped back into #shifts-grid instead of rendering as a
                               bare HTML page. hx-confirm replaces the CSP-violating
                               onsubmit="return confirm(...)". *@
                            <form method="post" action="@deleteUrl"
                                  hx-post="@deleteUrl"
                                  hx-target="#shifts-grid"
                                  hx-swap="innerHTML"
                                  hx-confirm="Delete this shift? This cannot be undone.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                <button type="submit" class="btn btn-sm sf-btn-danger"
                                        aria-label="Delete shift on @s.StartTime.ToString("MM/dd")">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
}
