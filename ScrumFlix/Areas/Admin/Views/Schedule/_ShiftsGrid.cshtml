@*
 * Partial: _ShiftsGrid.cshtml
 * Swapped by HTMX and by SignalR ShiftsUpdated event.
 *
 * FIX: Row hx-get was a hardcoded string "/Admin/Schedule/GetShift/@s.ShiftId"
 *      — converted to Url.Action() so route changes are picked up automatically.
 *
 * FIX: Delete form was a plain HTML POST with no HTMX attributes. Without HTMX
 *      on the form, the controller's PartialView response rendered as a bare HTML
 *      page. Added hx-post / hx-target / hx-swap to match every other form on
 *      this page.
 *
 * FIX: onsubmit="return confirm(...)" removed — inline event handlers are a CSP
 *      violation. Replaced with hx-confirm which HTMX handles natively without
 *      inline JS.
 *@
@model ScrumFlix.Areas.Admin.ViewModels.ShiftGridViewModel
@{
    var gridUrl = Url.Action("ShiftsGrid", "Schedule", new { area = "Admin" });
    var previous = Model.Page - 1;
    var next = Model.Page + 1;
    var prevArgs = new { area = "Admin", filterLocationId = Model.LocationId, filterRoleId = Model.RoleId,
        filterDate = Model.Date?.ToString("yyyy-MM-dd"), filterSort = Model.Sort, filterPage = previous };
    var nextArgs = new { area = "Admin", filterLocationId = Model.LocationId, filterRoleId = Model.RoleId,
        filterDate = Model.Date?.ToString("yyyy-MM-dd"), filterSort = Model.Sort, filterPage = next };
}

<form id="shift-filter-form" method="get" action="@Url.Action("Index", "Schedule", new { area = "Admin" })"
      hx-get="@gridUrl" hx-target="#shifts-grid" hx-swap="innerHTML"
      class="d-flex flex-wrap gap-2 align-items-end mb-3">
    <input type="hidden" name="tab" value="shifts" />
    <input type="hidden" name="filterPage" value="@Model.Page" />
    <div><label for="shift-filter-location" class="form-label">Location</label>
        <select id="shift-filter-location" name="filterLocationId" class="form-select">
            @foreach (var loc in Model.Locations)
            {
                <option value="@loc.Value" selected="@loc.Selected">@loc.Text</option>
            }
        </select></div>
    <div><label for="shift-filter-role" class="form-label">Role</label>
        <select id="shift-filter-role" name="filterRoleId" class="form-select">
            <option value="0" selected="@(Model.RoleId is null or 0)">All roles</option>
            @foreach (var role in Model.Roles)
            {
                <option value="@role.Value" selected="@role.Selected">@role.Text</option>
            }
        </select></div>
    <div><label for="shift-filter-date" class="form-label">Start date</label>
        <input id="shift-filter-date" name="filterDate" type="date" class="form-control"
               value="@(Model.Date?.ToString("yyyy-MM-dd"))" /></div>
    <div><label for="shift-filter-sort" class="form-label">Sort</label>
        <select id="shift-filter-sort" name="filterSort" class="form-select">
            <option value="start" selected="@(Model.Sort == "start")">Start: earliest</option>
            <option value="start_desc" selected="@(Model.Sort == "start_desc")">Start: latest</option>
            <option value="location" selected="@(Model.Sort == "location")">Location, then start</option>
            <option value="role" selected="@(Model.Sort == "role")">Role, then start</option>
        </select></div>
    <button type="submit" class="btn sf-btn-ghost">Apply</button>
</form>
<p class="sf-text-muted" role="status">@Model.TotalCount shifts · page @Model.Page of @Model.TotalPages</p>
@if (!ViewData.ModelState.IsValid)
{
    <div class="sf-flash-banner sf-flash-banner--danger" role="alert">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(state => state.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

@if (!Model.Rows.Any())
{
    <p class="sf-text-muted mt-3">No shifts defined yet. Add one using the form.</p>
}
else
{
    <div class="sf-admin-table-wrap">
    <div class="table-responsive">
        <table class="table sf-admin-table" aria-label="Shifts">
            <thead>
                <tr>
                    <th scope="col">Location</th>
                    <th scope="col">Role</th>
                    <th scope="col">Start</th>
                    <th scope="col">End</th>
                    <th scope="col">Duration</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Rows)
                {
                    var duration   = (s.EndTime - s.StartTime).TotalHours;
                    var editUrl    = Url.Action("GetShift",    "Schedule", new { area = "Admin", id = s.ShiftId });
                    var deleteUrl  = Url.Action("DeleteShift", "Schedule", new { area = "Admin" });

                    <tr hx-get="@editUrl"
                        hx-target="#shift-form-container"
                        hx-trigger="click"
                        style="cursor:pointer;"
                        title="Click to edit">
                        <td>@s.LocationName</td>
                        <td>@s.RoleName</td>
                        <td>@s.StartTime.ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>@s.EndTime.ToString("MM/dd/yyyy h:mm tt")</td>
                        <td>@duration.ToString("0.0")h</td>
                        <td class="text-end" data-sf-stop-row-click>
                            @* FIX: added hx-post/hx-target/hx-swap so the delete response
                               is swapped back into #shifts-grid instead of rendering as a
                               bare HTML page. hx-confirm replaces the CSP-violating
                               onsubmit="return confirm(...)". *@
                            <form method="post" action="@deleteUrl"
                                  hx-post="@deleteUrl"
                                  hx-include="#shift-filter-form"
                                  hx-target="#shifts-grid"
                                  hx-swap="innerHTML"
                                  hx-confirm="Delete this shift? This cannot be undone.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                <button type="submit" class="btn btn-sm sf-btn-danger"
                                        aria-label="Delete shift on @s.StartTime.ToString("MM/dd")">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>

    <nav class="d-flex gap-2 justify-content-between mt-3" aria-label="Shift pages">
        @if (Model.Page > 1)
        {
            <a class="btn sf-btn-ghost btn-sm" href="@Url.Action("Index", "Schedule", new { area = "Admin", tab = "shifts", filterLocationId = Model.LocationId, filterRoleId = Model.RoleId, filterDate = Model.Date?.ToString("yyyy-MM-dd"), filterSort = Model.Sort, filterPage = previous })"
               hx-get="@Url.Action("ShiftsGrid", "Schedule", prevArgs)" hx-target="#shifts-grid">Previous</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a class="btn sf-btn-ghost btn-sm ms-auto" href="@Url.Action("Index", "Schedule", new { area = "Admin", tab = "shifts", filterLocationId = Model.LocationId, filterRoleId = Model.RoleId, filterDate = Model.Date?.ToString("yyyy-MM-dd"), filterSort = Model.Sort, filterPage = next })"
               hx-get="@Url.Action("ShiftsGrid", "Schedule", nextArgs)" hx-target="#shifts-grid">Next</a>
        }
    </nav>
}
